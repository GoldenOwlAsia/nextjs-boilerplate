# Canonical origin of this app — metadata, OG images, absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL the browser calls. Keep it relative to go through the proxy route
# (src/app/api/[...path]/route.ts): the backend origin stays private and there is
# no CORS to configure. Set an absolute URL to call the backend directly instead.
NEXT_PUBLIC_API_BASE_URL=/api

# Absolute backend origin used by the server: Server Components, prefetch, and
# the proxy route itself. Must NOT point back at this app.
API_BASE_URL=http://localhost:8080
